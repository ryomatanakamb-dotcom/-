<!DOCTYPE html>
<html lang="ja">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>掃除当番決定ツール v4.0</title>
    <style>
        :root {
            --primary-color: #4a90e2;
            --reset-color: #e67e22;
            --bg-color: #f0f4f8;
            --accent-color: #ff4757;
            --p1: #f9a825;
            --p2: #66bb6a;
            --p34: #90a4ae;
            --done: #e53935;
            --p0: #7b1fa2;
        }
        html, body { height: 100%; margin: 0; }
        body {
            font-family: 'Helvetica Neue', Arial, sans-serif;
            display: flex; flex-direction: column; align-items: center;
            background-color: var(--bg-color);
            padding: 8px 12px; box-sizing: border-box;
            height: 100vh; overflow: hidden;
        }
        h1 { color: #333; margin: 0 0 2px; font-size: 1.2em; }
        .subtitle { color: #888; font-size: 0.75em; margin: 0 0 6px; }

        /* メインレイアウト：左(入力) 中(ルーレット) 右(当選) */
        .layout {
            display: grid;
            grid-template-columns: 1fr 1fr 220px;
            gap: 10px; width: 100%; flex: 1; min-height: 0;
        }

        .panel {
            background: white; padding: 10px 12px; border-radius: 12px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.07);
            min-height: 0; display: flex; flex-direction: column;
        }
        h3 { margin: 0 0 6px; color: #333; border-left: 4px solid var(--primary-color); padding-left: 8px; font-size: 0.88em; }

        /* ===== 左パネル：2×2グリッド ===== */
        .input-panel {
            display: flex; flex-direction: column;
        }
        .legend {
            display: flex; flex-wrap: wrap; gap: 4px;
            margin-bottom: 6px; font-size: 0.7em; flex-shrink: 0;
        }
        .legend-item {
            display: flex; align-items: center; gap: 4px;
            background: #f5f5f5; padding: 2px 6px; border-radius: 20px;
        }
        .legend-dot { width: 8px; height: 8px; border-radius: 50%; flex-shrink: 0; }

        .grid-2x2 {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 6px;
            flex: 1; min-height: 0;
        }

        .period-block {
            border-radius: 8px; overflow: hidden;
            border: 2px solid transparent;
            display: flex; flex-direction: column; min-height: 0;
        }
        .period-block.p1   { border-color: var(--p1); }
        .period-block.p2   { border-color: var(--p2); }
        .period-block.p34  { border-color: var(--p34); }
        .period-block.pdone{ border-color: var(--done); }
        .period-block.p0   { border-color: var(--p0); }

        .period-header {
            display: flex; align-items: center;
            padding: 4px 8px; font-weight: bold; font-size: 0.75em; color: white;
            flex-shrink: 0;
        }
        .p1    .period-header { background: var(--p1); }
        .p2    .period-header { background: var(--p2); }
        .p34   .period-header { background: var(--p34); }
        .pdone .period-header { background: var(--done); }
        .p0    .period-header { background: var(--p0); }

        .period-meta {
            font-size: 0.78em; font-weight: normal; opacity: 0.9;
            margin-left: auto; background: rgba(0,0,0,0.15);
            padding: 1px 5px; border-radius: 8px; white-space: nowrap;
        }

        .period-body { flex: 1; min-height: 0; background: #fafafa; padding: 4px; }

        textarea {
            width: 100%; height: 100%; padding: 5px;
            border: none; background: transparent;
            box-sizing: border-box; font-size: 12px; resize: none;
            font-family: inherit; outline: none; line-height: 1.6;
        }

        /* ===== 設定・ボタン（左パネル下部） ===== */
        .controls {
            flex-shrink: 0; margin-top: 6px;
            display: flex; gap: 8px; align-items: center;
        }
        .setting-row { display: flex; align-items: center; gap: 6px; font-size: 0.82em; }
        select { padding: 3px 8px; border-radius: 5px; border: 1px solid #ccc; font-size: 13px; }
        .btn-group { display: flex; gap: 6px; flex: 1; }
        button {
            flex: 1; padding: 7px; border: none; border-radius: 8px; font-size: 13px;
            font-weight: bold; cursor: pointer; transition: 0.2s; color: white;
        }
        #spinBtn { background-color: var(--primary-color); }
        #spinBtn:hover { background-color: #357abd; }
        #spinBtn:disabled { background-color: #ccc; cursor: not-allowed; }
        #resetBtn { background-color: var(--reset-color); }
        #resetBtn:hover { background-color: #cf6d17; }

        /* ===== ホイール ===== */
        .wheel-container {
            position: relative; display: flex; flex-direction: column;
            align-items: center; justify-content: center;
        }
        .arrow {
            position: absolute; top: -8px; left: 50%; transform: translateX(-50%);
            width: 0; height: 0; border-left: 12px solid transparent;
            border-right: 12px solid transparent; border-top: 24px solid var(--accent-color);
            z-index: 10;
        }
        #resultDisplay {
            min-height: 1.2em; margin-top: 6px;
            color: var(--accent-color); font-size: 1.1em; font-weight: bold;
        }

        /* ===== 当選パネル ===== */
        .winner-tag {
            background: #e1f5fe; border: 1px solid #b3e5fc;
            padding: 3px 8px; margin: 3px 0; border-radius: 5px;
            display: block; font-size: 0.88em;
            animation: popIn 0.3s cubic-bezier(0.68, -0.55, 0.27, 1.55);
        }
        @keyframes popIn { from { transform: scale(0); opacity:0; } to { transform: scale(1); opacity:1; } }
        .count-badge {
            background: #333; color: white;
            padding: 1px 7px; border-radius: 10px; font-size: 0.78em;
        }
    </style>
</head>
<body>

<h1>掃除当番決定ツール v4.0</h1>
<p class="subtitle">早く来た人ほど当選確率が下がる優遇システム搭載</p>

<div class="layout">

    <!-- 左パネル：名前入力 2×2グリッド -->
    <div class="panel input-panel">
        <h3>出席状況の入力</h3>
        <div class="legend">
            <div class="legend-item"><div class="legend-dot" style="background:var(--p0)"></div>授業前：×0.15</div>
            <div class="legend-item"><div class="legend-dot" style="background:var(--p1)"></div>1コマ目：×0.3</div>
            <div class="legend-item"><div class="legend-dot" style="background:var(--p2)"></div>2コマ目：×0.55</div>
            <div class="legend-item"><div class="legend-dot" style="background:var(--p34)"></div>午後：×1.0</div>
            <div class="legend-item"><div class="legend-dot" style="background:var(--done)"></div>今週済み：×0.1（重複可）</div>
        </div>

        <div class="grid-2x2">
            <div class="period-block p0">
                <div class="period-header">🌠 授業開始前<span class="period-meta">×0.15</span></div>
                <div class="period-body"><textarea id="names0" placeholder="1人1行&#10;例）田中&#10;佐藤"></textarea></div>
            </div>
            <div class="period-block p1">
                <div class="period-header">🌅 1コマ目<span class="period-meta">×0.3</span></div>
                <div class="period-body"><textarea id="names1" placeholder="1人1行&#10;例）鈴木&#10;高橋"></textarea></div>
            </div>
            <div class="period-block p2">
                <div class="period-header">🌄 2コマ目<span class="period-meta">×0.55</span></div>
                <div class="period-body"><textarea id="names2" placeholder="1人1行&#10;例）伊藤&#10;渡辺"></textarea></div>
            </div>
            <div class="period-block p34">
                <div class="period-header">🌆 3・4コマ目<span class="period-meta">×1.0</span></div>
                <div class="period-body"><textarea id="names34" placeholder="1人1行&#10;例）山本&#10;中村"></textarea></div>
            </div>
            <div class="period-block pdone" style="grid-column: 1 / -1;">
                <div class="period-header">🧹 今週すでに掃除をした人<span class="period-meta">×0.1（出席倍率と掛け合わせ）</span></div>
                <div class="period-body" style="min-height:50px;"><textarea id="namesDone" placeholder="1人1行　※上の欄に名前を入れた上で、ここにも入力してください"></textarea></div>
            </div>
        </div>

        <div class="controls">
            <div class="setting-row">
                <label for="winnerCountSelect">当選：</label>
                <select id="winnerCountSelect">
                    <option value="1">1人</option>
                    <option value="2">2人</option>
                    <option value="3">3人</option>
                    <option value="4">4人</option>
                    <option value="5" selected>5人</option>
                    <option value="6">6人</option>
                    <option value="7">7人</option>
                    <option value="8">8人</option>
                    <option value="9">9人</option>
                    <option value="10">10人</option>
                </select>
            </div>
            <div class="btn-group">
                <button id="spinBtn">ルーレットを回す！</button>
                <button id="resetBtn">リセット</button>
            </div>
        </div>
    </div>

    <!-- 中央：ルーレット -->
    <div class="wheel-container">
        <div class="arrow"></div>
        <canvas id="wheelCanvas"></canvas>
        <h2 id="resultDisplay"> </h2>
    </div>

    <!-- 右パネル：当選者 -->
    <div class="panel">
        <h3>今回の当選者 <span id="winnerCountDisplay" class="count-badge">0 / 5</span></h3>
        <div id="currentWinners"></div>
    </div>
</div>

<script>
    const canvas = document.getElementById('wheelCanvas');
    const ctx = canvas.getContext('2d');
    const names0Input   = document.getElementById('names0');
    const names1Input   = document.getElementById('names1');
    const names2Input   = document.getElementById('names2');
    const names34Input  = document.getElementById('names34');
    const namesDoneInput= document.getElementById('namesDone');
    const spinBtn = document.getElementById('spinBtn');
    const resetBtn = document.getElementById('resetBtn');
    const winnerCountSelect = document.getElementById('winnerCountSelect');
    const resultDisplay = document.getElementById('resultDisplay');
    const currentWinnersDiv = document.getElementById('currentWinners');
    const winnerCountDisplay = document.getElementById('winnerCountDisplay');

    let currentAngle = 0;
    let isSpinning = false;
    let sessionWinners = [];
    let pastSessions = [];

    // ===== 音声 =====
    const audioCtx = new (window.AudioContext || window.webkitAudioContext)();

    function playTick() {
        const osc = audioCtx.createOscillator();
        const gain = audioCtx.createGain();
        osc.type = 'sine';
        osc.frequency.setValueAtTime(800, audioCtx.currentTime);
        osc.frequency.exponentialRampToValueAtTime(100, audioCtx.currentTime + 0.1);
        gain.gain.setValueAtTime(0.1, audioCtx.currentTime);
        gain.gain.exponentialRampToValueAtTime(0.01, audioCtx.currentTime + 0.1);
        osc.connect(gain); gain.connect(audioCtx.destination);
        osc.start(); osc.stop(audioCtx.currentTime + 0.1);
    }

    function playFanfare() {
        [523.25, 659.25, 783.99, 1046.50].forEach((freq, i) => {
            const osc = audioCtx.createOscillator();
            const gain = audioCtx.createGain();
            osc.frequency.setValueAtTime(freq, audioCtx.currentTime + i * 0.15);
            gain.gain.setValueAtTime(0, audioCtx.currentTime + i * 0.15);
            gain.gain.linearRampToValueAtTime(0.1, audioCtx.currentTime + i * 0.15 + 0.05);
            gain.gain.exponentialRampToValueAtTime(0.01, audioCtx.currentTime + i * 0.15 + 0.4);
            osc.connect(gain); gain.connect(audioCtx.destination);
            osc.start(audioCtx.currentTime + i * 0.15);
            osc.stop(audioCtx.currentTime + i * 0.15 + 0.5);
        });
    }

    // ===== ルーレット =====
    const colors = ['#ff9f43','#ee5253','#10ac84','#2e86de','#f368e0','#0abde3','#5f27cd','#00d2d3'];

    function parseNames(el) {
        return el.value.split('\n').map(n => n.trim()).filter(n => n !== '');
    }

    function getAttendanceWeight(name) {
        if (parseNames(names0Input).includes(name))  return 0.15;
        if (parseNames(names1Input).includes(name))  return 0.3;
        if (parseNames(names2Input).includes(name))  return 0.55;
        return 1.0;
    }

    function getItems() {
        // 出席欄の全員をルーレット対象に（今週済みの人も出席欄に入れてもらう前提）
        const all = [
            ...parseNames(names0Input),
            ...parseNames(names1Input),
            ...parseNames(names2Input),
            ...parseNames(names34Input)
        ];
        const seen = new Set();
        const unique = [];
        for (const n of all) { if (!seen.has(n)) { seen.add(n); unique.push(n); } }

        const done = parseNames(namesDoneInput);
        return unique
            .filter(name => !sessionWinners.includes(name))
            .map(name => {
                let w = getAttendanceWeight(name);
                if (done.includes(name)) w *= 0.1;
                if (pastSessions[0]?.includes(name)) w *= 0.1;
                else if (pastSessions[1]?.includes(name)) w *= 0.4;
                return { name, weight: w };
            });
    }

    function drawWheel() {
        const items = getItems();
        const cx = canvas.width / 2, cy = canvas.height / 2;
        const r = Math.min(cx, cy) - 20;
        ctx.clearRect(0, 0, canvas.width, canvas.height);
        if (items.length === 0) {
            ctx.fillStyle = '#bbb'; ctx.font = 'bold 16px sans-serif';
            ctx.textAlign = 'center';
            ctx.fillText('名前を入力してください', cx, cy);
            return;
        }
        const total = items.reduce((s, i) => s + i.weight, 0);
        let angle = currentAngle;
        items.forEach((item, i) => {
            const slice = (item.weight / total) * 2 * Math.PI;
            ctx.beginPath(); ctx.moveTo(cx, cy);
            ctx.arc(cx, cy, r, angle, angle + slice);
            ctx.closePath();
            ctx.fillStyle = colors[i % colors.length]; ctx.fill();
            ctx.strokeStyle = 'white'; ctx.lineWidth = 2; ctx.stroke();
            ctx.save();
            ctx.translate(cx, cy); ctx.rotate(angle + slice / 2);
            ctx.textAlign = 'right'; ctx.fillStyle = 'white';
            ctx.font = 'bold 15px sans-serif';
            ctx.fillText(item.name, r - 15, 5);
            ctx.restore();
            angle += slice;
        });
    }

    function spin() {
        const max = parseInt(winnerCountSelect.value);
        if (isSpinning || sessionWinners.length >= max) return;
        const items = getItems();
        if (items.length === 0) return;
        if (audioCtx.state === 'suspended') audioCtx.resume();

        isSpinning = true; spinBtn.disabled = true;
        resultDisplay.textContent = '抽選中...';

        const duration = 4000;
        const startRot = currentAngle;
        const extra = Math.PI * 2 * (10 + Math.random() * 5);
        const startTime = performance.now();
        let lastTick = 0;

        function animate(now) {
            const p = Math.min((now - startTime) / duration, 1);
            const ease = 1 - Math.pow(1 - p, 4);
            currentAngle = startRot + extra * ease;
            if (Math.abs(currentAngle - lastTick) > 0.25) { playTick(); lastTick = currentAngle; }
            drawWheel();
            if (p < 1) requestAnimationFrame(animate);
            else finalizeSpin(items);
        }
        requestAnimationFrame(animate);
    }

    function finalizeSpin(items) {
        isSpinning = false;
        const total = items.reduce((s, i) => s + i.weight, 0);
        let norm = (1.5 * Math.PI - currentAngle) % (2 * Math.PI);
        while (norm < 0) norm += 2 * Math.PI;

        let cum = 0, winner = items[0];
        for (const item of items) {
            const slice = (item.weight / total) * 2 * Math.PI;
            if (norm >= cum && norm < cum + slice) { winner = item; break; }
            cum += slice;
        }

        sessionWinners.push(winner.name);
        resultDisplay.textContent = `当選：${winner.name} さん！`;
        playFanfare(); updateUI(); drawWheel();

        const max = parseInt(winnerCountSelect.value);
        if (sessionWinners.length < max) spinBtn.disabled = false;
        else resultDisplay.textContent = '全メンバーの選出完了！';
    }

    function updateUI() {
        currentWinnersDiv.innerHTML = sessionWinners.map(n => `<span class="winner-tag">${n}</span>`).join('');
        winnerCountDisplay.textContent = `${sessionWinners.length} / ${winnerCountSelect.value}`;
    }

    function resetSession() {
        if (sessionWinners.length > 0) {
            pastSessions.unshift([...sessionWinners]);
            if (pastSessions.length > 2) pastSessions.pop();
        }
        sessionWinners = [];
        resultDisplay.textContent = ' ';
        spinBtn.disabled = false;
        updateUI(); drawWheel();
    }

    [names0Input, names1Input, names2Input, names34Input, namesDoneInput].forEach(el => el.addEventListener('input', drawWheel));
    winnerCountSelect.addEventListener('change', updateUI);
    spinBtn.addEventListener('click', spin);
    resetBtn.addEventListener('click', resetSession);

    function resizeCanvas() {
        const size = Math.min(
            window.innerHeight - 90,
            canvas.parentElement.clientWidth - 20,
            520
        );
        canvas.width = size; canvas.height = size;
        drawWheel();
    }
    window.addEventListener('resize', resizeCanvas);
    resizeCanvas();
    updateUI();
</script>
</body>
</html>
